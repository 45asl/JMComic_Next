<resources>
    <!--
      Window-level theme only. All in-app colour, shape and typography comes from
      the Compose design system (see ui/theme/). The window background matches the
      Compose backdrop so there is no flash of a different colour on cold start.
    -->
    <style name="Theme.JMComic_Next" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_backdrop</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
